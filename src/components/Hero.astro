---
const registerUrl = "https://airtable.com/appmORmY9unGbIHj2/shrhzXFYpqEqBYmKl";
---

<div class="parallax-container">
    <div class="slider_area slider_overlay">
        <div class="slider_text">
            <div class="container">
                <div class="position_relv parallax-container">
                    <div class="vertical-text">
                        <h1 class="opcity_text d-none d-lg-block">HACKATHON</h1>
                    </div>
                    <div class="row">
                        <div class="col-xl-9">
                            <div class="title_text">
                                <h3 class="landing_text">
                                    CivicHacks 2025<br>
                                    Hackathon @<br>
                                    Boston University
                                </h3>
                                <a href={registerUrl} class="boxed-btn-white" target="_blank" rel="noopener noreferrer">
                                    Register Now
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="countDOwn_area">
            <div class="slider-container">
                <div class="row align-items-center">
                    <div class="col-xl-4 col-md-6 col-lg-4">
                        <div class="single_date">
                            <i class="ti-location-pin"></i>
                            <span>CDS,&nbsp; 665 Commonwealth Ave</span>
                        </div>
                    </div>
                    <div class="col-xl-4 col-md-6 col-lg-4">
                        <div class="single_date">
                            <i class="ti-alarm-clock"></i>
                            <span>22nd-23rd Feb 2025</span>
                        </div>
                    </div>
                    <div class="col-xl-4 col-md-12 col-lg-4">
                        <span id="clock"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <img src="/img/hi-rescds-building.png" class="parallax" alt="Center for Computing & Data Sciences building" width="100%">
    <img src="/img/bg7.png" class="parallax2" alt="">
</div>

