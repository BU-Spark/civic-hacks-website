---
const articleUrl = "https://www.bu.edu/spark/2024/03/19/civic-tech-hackathon-demonstrates-the-power-of-public-interest-technology-for-second-year/";
---

<div class="about_area parallax-end">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-xl-6 col-md-12">
                <div class="about_thumb">
                    <img 
                        src="/img/CH24ArticlePhoto.png" 
                        alt="Many dozen students during 2024's hackathon on the 17th floor of the Center for Computing & Data Sciences building." 
                        height="100%"
                    >
                </div>
            </div>
            <div class="col-xl-5 offset-xl-1 col-md-12">
                <div class="about_info">
                    <div class="section_title">
                        <span class="sub_heading">Imagine a world where</span>
                        <h3>
                            Students Drive <br>
                            Innovation to Build<br>
                            a more Equitable Future
                        </h3>
                    </div>
                    <p>More info on tracks soon.</p>
                    <a href={articleUrl} class="boxed-btn-red" target="_blank" rel="noopener noreferrer">
                        Read about 2024
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

