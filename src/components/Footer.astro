---
const venueUrl = "https://maps.app.goo.gl/E1RZcsFnY5jMipXN8";
const sparkUrl = "https://www.bu.edu/spark/";
const instagramUrl = "https://www.instagram.com/bu_spark/";
const linkedinUrl = "https://www.linkedin.com/company/bu-spark";
---

<footer class="footer footer_bg_1">
    <div class="footer_top">
        <div class="container">
            <div class="row">
                <div class="col-xl-4 col-md-4 col-lg-4">
                    <div class="footer_widget">
                        <h3 class="footer_title">Connect with us</h3>
                        <ul>
                            <li><a target="_blank" href={sparkUrl}>Spark! Website</a></li>
                            <li><a target="_blank" href={instagramUrl}>Instagram</a></li>
                            <li><a target="_blank" href={linkedinUrl}>LinkedIn</a></li>
                        </ul>
                    </div>
                </div>
                <div class="col-xl-4 col-md-4 col-lg-4">
                    <div class="footer_widget">
                        <h3 class="footer_title">Links</h3>
                        <ul>
                            <li><a href="/conduct.html">Code of Conduct</a></li>
                        </ul>
                    </div>
                </div>
                <div class="col-xl-4 col-md-4 col-lg-4">
                    <div class="footer_widget">
                        <h3 class="footer_title">Venue</h3>
                        <a href={venueUrl} target="_blank" class="footer_address">
                            <p>
                                665 Commonwealth Ave, 17th Floor, Boston MA <br />
                                sparkcomm@bu.edu<br />
                            </p>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="copy-right_text">
        <div class="container">
            <div class="footer_border"></div>
            <div class="row">
                <div class="col-xl-12">
                    <p class="copy_right text-center">
                        Copyright &copy;<script>document.write(new Date().getFullYear());</script> All rights reserved | This template is made with <i class="fa fa-heart-o" aria-hidden="true"></i> by <a href="https://colorlib.com" target="_blank">Colorlib</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</footer>

