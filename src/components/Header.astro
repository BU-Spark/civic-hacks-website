---
const registerUrl = "https://airtable.com/appmORmY9unGbIHj2/shrhzXFYpqEqBYmKl";
---

<header class="header-class">
    <div class="header-area">
        <div id="sticky-header" class="main-header-area">
            <div class="container-fluid p-0">
                <div class="row align-items-center justify-content-between no-gutters">
                    <div class="col-xl-2 col-lg-2">
                        <div class="logo-img">
                            <a href="/">
                                <img src="/img/CHLogo-WideStack.png" alt="Civic Hacks Logo" width="100%">
                            </a>
                        </div>
                    </div>
                    <div class="col-xl-7 col-lg-7">
                        <div class="main-menu d-none d-lg-block">
                            <nav>
                                <ul id="navigation">
                                    <li><a href="#schedule">Agenda</a></li>
                                    <li><a href="#expo">Learning Expo</a></li>
                                    <li><a href="#sponsors">Sponsors</a></li>
                                    <li><a href="#" class="disabled">Biodiversity</a></li>
                                    <li><a href="#faq">FAQ</a></li>
                                </ul>
                            </nav>
                        </div>
                    </div>
                    <div class="col-xl-1 col-lg-1 d-none d-lg-block"></div>
                    <div class="col-xl-2 col-lg-2 d-none d-lg-block">
                        <div class="buy_ticket">
                            <a target="_blank" href={registerUrl} class="boxed-btn-white">Register Now</a>
                        </div>
                    </div>
                    <div class="col-12 mobile_column">
                        <div class="mobile_menu d-block d-lg-none"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>

